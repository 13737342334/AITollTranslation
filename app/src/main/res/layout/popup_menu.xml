<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/menu_width"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_menu_popup"
    android:padding="4dp">

    <TextView
        android:id="@+id/menu_translate_page"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/menu_translate_page"
        android:textColor="@color/menu_text"
        android:textSize="15sp"
        android:drawableStart="@drawable/ic_camera"
        android:drawablePadding="12dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#33FFFFFF" />

    <TextView
        android:id="@+id/menu_subtitle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/menu_start_subtitle"
        android:textColor="@color/menu_text"
        android:textSize="15sp"
        android:drawableStart="@drawable/ic_play"
        android:drawablePadding="12dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#33FFFFFF" />

    <TextView
        android:id="@+id/menu_settings"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/menu_settings"
        android:textColor="@color/menu_text"
        android:textSize="15sp"
        android:drawableStart="@drawable/ic_settings"
        android:drawablePadding="12dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#33FFFFFF" />

    <TextView
        android:id="@+id/menu_hide"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/menu_hide"
        android:textColor="#FF888888"
        android:textSize="15sp"
        android:drawableStart="@drawable/ic_close"
        android:drawablePadding="12dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
